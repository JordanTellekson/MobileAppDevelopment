<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeApp.Views.UpdateRecipePage"
             Title="Update Recipe"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Title -->
            <Label Text="Recipe Title"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Entry Placeholder="Spaghetti Bolognese"
                   PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                   Text="{Binding Title}"
                   BackgroundColor="{DynamicResource EntryBackgroundColor}"
                   TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Description -->
            <Label Text="Description"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Editor Placeholder="A classic Italian pasta dish with rich tomato sauce."
                    PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                    Text="{Binding Description}"
                    HeightRequest="60"
                    BackgroundColor="{DynamicResource EntryBackgroundColor}"
                    TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Image URL -->
            <Label Text="Image URL"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Entry Placeholder="https://example.com/spaghetti.jpg"
                   PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                   Text="{Binding ImageUrl}"
                   BackgroundColor="{DynamicResource EntryBackgroundColor}"
                   TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Cooking Time -->
            <Label Text="Cooking Time (minutes)"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Entry Placeholder="45"
                   PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                   Keyboard="Numeric"
                   Text="{Binding CookingTimeMinutes}"
                   BackgroundColor="{DynamicResource EntryBackgroundColor}"
                   TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Ingredients -->
            <Label Text="Ingredients"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Editor Placeholder="Spaghetti, ground beef, tomato sauce, garlic, onion, olive oil"
                    PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                    Text="{Binding Ingredients}"
                    HeightRequest="80"
                    BackgroundColor="{DynamicResource EntryBackgroundColor}"
                    TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Instructions -->
            <Label Text="Instructions"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Editor Placeholder="Boil pasta. Cook beef with sauce. Combine and serve hot."
                    PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                    Text="{Binding Instructions}"
                    HeightRequest="120"
                    BackgroundColor="{DynamicResource EntryBackgroundColor}"
                    TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Action Buttons -->
            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                <Button Text="Save"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{DynamicResource ButtonBackgroundColor}"
                        TextColor="{DynamicResource ButtonTextColor}"
                        CornerRadius="8" />

                <Button Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{DynamicResource ButtonBackgroundColor}"
                        TextColor="{DynamicResource ButtonTextColor}"
                        CornerRadius="8" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>