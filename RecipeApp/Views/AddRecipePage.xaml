<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="PageRoot"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeApp.Views.AddRecipePage"
             Title="Add Recipe"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Title -->
            <Label Text="Recipe Title"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Entry Placeholder="Spaghetti Bolognese"
                   PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                   Text="{Binding Title}"
                   BackgroundColor="{DynamicResource EntryBackgroundColor}"
                   TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Category -->
            <Label Text="Category"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Entry Placeholder="Type a category"
                   PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                   Text="{Binding CategoryText, Mode=TwoWay}"
                   BackgroundColor="{DynamicResource EntryBackgroundColor}"
                   TextColor="{DynamicResource PrimaryTextColor}"/>
            <CollectionView ItemsSource="{Binding FilteredCategories}"
                            IsVisible="{Binding IsCategorySuggestionsVisible}"
                            BackgroundColor="{DynamicResource EntryBackgroundColor}"
                            SelectionMode="Single"
                            HeightRequest="120">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Name}" 
                               Padding="5"
                               TextColor="{DynamicResource PrimaryTextColor}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                    CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Description -->
            <Label Text="Description"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Editor Placeholder="A classic Italian pasta dish with rich tomato sauce."
                    PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                    Text="{Binding Description}"
                    HeightRequest="60"
                    BackgroundColor="{DynamicResource EntryBackgroundColor}"
                    TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Image URL -->
            <Label Text="Image URL"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Entry Placeholder="https://example.com/spaghetti.jpg"
                   PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                   Text="{Binding ImageUrl}"
                   BackgroundColor="{DynamicResource EntryBackgroundColor}"
                   TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Cooking Time -->
            <Label Text="Cooking Time (minutes)"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Entry Placeholder="45"
                   PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                   Keyboard="Numeric"
                   Text="{Binding CookingTimeMinutes}"
                   BackgroundColor="{DynamicResource EntryBackgroundColor}"
                   TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Ingredients -->
            <Label Text="Ingredients"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Editor Placeholder="Spaghetti, ground beef, tomato sauce, garlic, onion, olive oil"
                    PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                    Text="{Binding Ingredients}"
                    HeightRequest="80"
                    BackgroundColor="{DynamicResource EntryBackgroundColor}"
                    TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Instructions -->
            <Label Text="Instructions"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold"/>
            <Editor Placeholder="Boil pasta. Cook beef with sauce. Combine and serve hot."
                    PlaceholderColor="{DynamicResource PlaceholderTextColor}"
                    Text="{Binding Instructions}"
                    HeightRequest="120"
                    BackgroundColor="{DynamicResource EntryBackgroundColor}"
                    TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Save Button -->
            <Button Text="Save Recipe"
                    Command="{Binding SaveRecipeCommand}"
                    BackgroundColor="{DynamicResource ButtonBackgroundColor}"
                    TextColor="{DynamicResource ButtonTextColor}"
                    CornerRadius="8"
                    Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>